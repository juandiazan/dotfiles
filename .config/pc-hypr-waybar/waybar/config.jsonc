{
  "include": [
    "$HOME/.config/waybar/modules/modules-left.jsonc",
    "$HOME/.config/waybar/modules/modules-center.jsonc",
    "$HOME/.config/waybar/modules/modules-right.jsonc",
  ],
  "layer": "bottom",
  "position": "bottom",
  "spacing": 8,
  "height": 35,
  "modules-left": [
    "hyprland/workspaces",
    "wlr/taskbar",
    "hyprland/window"
  ],
  "modules-center": [
    "clock",
    "custom/distro",
    "mpris"
  ],
  "modules-right": [
    "custom/notification",
    "bluetooth",
    "network",
    "pulseaudio#output",
    "pulseaudio#input",
    "cpu",
    "memory",
    "disk",
    "idle_inhibitor",
    "hyprland/language",
    "custom/settings"
  ],
}