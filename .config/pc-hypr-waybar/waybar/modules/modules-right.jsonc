{
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "bluetooth": {
        "format": "",
        "format-disabled": "󰂲 disconnected",
        "format-connected": " connected",
        "tooltip-format": "Devices connected: {num_connections}",
        "on-click": "~/.config/waybar/scripts/bluetooth-open.sh",
        "on-click-right": "~/.config/waybar/scripts/bluetooth-toggle.sh"
    },
    "network": {
        "format-ethernet": "󰌘 online",
        "format-disconnected": "󰌙 disconnected",
        "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}"
    },
    "pulseaudio#output": {
        "format": "{icon} {volume}%",
        "format-muted": "{icon} {volume}%",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ],
            "default-muted": "󰝟",
            "headphone": "󰋋",
            "headphone-muted": "󰟎",
            "headset": "󰋎",
            "headset-muted": "󰋐"
        },
        "tooltip-format": "<b>Output Device</b>: {desc} at {volume}%",
        "on-click": "~/.config/waybar/scripts/audio-open.sh",
        "on-click-middle": "~/.config/waybar/scripts/change-audio-output.sh",
        "on-click-right": "~/.config/waybar/scripts/volume.sh output mute",
        "on-scroll-up": "~/.config/waybar/scripts/volume.sh output raise",
        "on-scroll-down": "~/.config/waybar/scripts/volume.sh output lower"
    },
    "pulseaudio#input": {
        "format": "{format_source}",
        "format-source": "󰍬 {volume}%",
        "format-source-muted": "󰍭 {volume}%",
        "on-click": "~/.config/waybar/scripts/volume.sh input mute",
        "on-scroll-up": "~/.config/waybar/scripts/volume.sh input raise",
        "on-scroll-down": "~/.config/waybar/scripts/volume.sh input lower",
        "tooltip-format": "<b>Input Device</b>: {desc} at {volume}%" // currently does not work
    },
    // ----------------------------- HARDWARE GROUP ----------------------------- 
    "cpu": {
        "interval": 5,
        "format": "CPU:{usage}%",
        "on-click": "~/.config/waybar/scripts/hardware-monitor-open.sh"
    },
    "memory": {
        "interval": 5,
        "format": "MEM:{}%",
        "on-click": "~/.config/waybar/scripts/hardware-monitor-open.sh"
    },
    "disk": {
        "interval": 5,
        "format": "DSK:{percentage_used}%",
        "path": "/",
        "on-click": "~/.config/waybar/scripts/hardware-monitor-open.sh"
    },
    // ----------------------------- END OF HARDWARE GROUP ----------------------------- 
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰌾 on",
            "deactivated": "󰌵 off"
        },
        "tooltip-format-activated": "Idle inhibitor: ON",
        "tooltip-format-deactivated": "Idle inhibitor: OFF"
    },
    "hyprland/language": {
        "on-click": "hyprctl switchxkblayout ckb1:-corsair-gaming-k95-rgb-platinum-keyboard-vkb next",
        "format-es": " ESP",
        "format-en": " ENG"
    },
    "custom/settings": {
        "on-click": "ags toggle control-panel",
        "format": " ",
        "escape": true,
        "tooltip": false
    }
}